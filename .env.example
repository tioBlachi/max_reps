# Local development behavior
APP_ENV=development

# PostgreSQL container configuration
POSTGRES_USER=maxreps
POSTGRES_PASSWORD=
POSTGRES_DB=maxreps
POSTGRES_PORT=5432

# Redis and FastAPI host ports
REDIS_PORT=6379
FASTAPI_PORT=8000

# JWT configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRATION_MINUTES=30

# Initial administrator account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

#CORS
CORS_ORIGINS=http://localhost:3000